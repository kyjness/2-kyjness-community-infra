# Target 전용: Rollout blueGreen 의 active/preview Service. rollout.yaml.bak 과 세트.
# -----------------------------------------------------------------------------
# Argo Rollouts Blue/Green: activeService / previewService로 참조됩니다.
# -----------------------------------------------------------------------------
apiVersion: v1
kind: Service
metadata:
  name: puppytalk-api-active
  labels:
    app.kubernetes.io/name: puppytalk-api
    app.kubernetes.io/component: active
spec:
  type: ClusterIP
  selector:
    app: puppytalk-api
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: v1
kind: Service
metadata:
  name: puppytalk-api-preview
  labels:
    app.kubernetes.io/name: puppytalk-api
    app.kubernetes.io/component: preview
spec:
  type: ClusterIP
  selector:
    app: puppytalk-api
  ports:
    - name: http
      port: 80
      targetPort: http
